CC = gcc
CFLAGS = -Wall -Wextra -O2 -I. -Icore

HEADERS = $(wildcard *.h core/*.h)
CORE_SRCS = $(wildcard core/*.c)
CORE_OBJS = $(CORE_SRCS:.c=.o)

TARGETS = laserSend laserReceive motorSend motorReceive

.PHONY: all clean

all: $(TARGETS)

$(TARGETS): %: %.o $(CORE_OBJS)
	$(CC) -o $@ $^

%.o: %.c $(HEADERS)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(TARGETS) *.o core/*.o
